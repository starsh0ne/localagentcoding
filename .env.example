# ===== LLM (v0.2) =====
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ===== 工具 (v0.3) =====
TOOLS_ENABLED=

# ===== 记忆 (v0.4) =====
# v0.4新增: 长期记忆向量检索(可选)
# 注意: DeepSeek不提供embedding API。不配置则自动降级FTS5关键词检索(零配置可用)
# 示例(硅基流动): EMBEDDING_MODEL=BAAI/bge-m3
#                 EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#                 EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# v0.5新增: API服务（uv run python -m agent_pro.api）
API_HOST=0.0.0.0        # 局域网测试; 仅本机用127.0.0.1
API_PORT=8000
API_AUTH_KEY=请改成足够长的随机字符串   # 空值=服务拒绝启动

# v0.6: 知识库文档目录(默认./knowledge, 可用绝对路径覆盖)
# KB_DIR=./knowledge

MEMORY_WINDOW_SIZE=10

# ===== RAG (v0.5) =====
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_PATH=./data/vectorstore

# ===== 评估 (v0.6) =====
EVAL_DATASET_PATH=./data/eval

# ===== 可观测性 (v0.7) =====
LOG_LEVEL=INFO                 # DEBUG/INFO/WARNING/ERROR
LOG_DIR=./logs                 # 结构化日志落盘目录(已 gitignore)

# ===== 可观测性 (v0.8) =====
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
OTLP_ENDPOINT=

# ===== 状态持久化 (v0.9) =====
# Redis 后端(可选): 留空=默认 redis://localhost:6379; 不可用时自动降级内存态(重启丢)
# REDIS_URL=redis://localhost:6379
