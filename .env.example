# ===== LLM (v0.2) =====
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ===== 工具 (v0.3) =====
# 注: 以下键在 config.Settings 里没有对应字段, 写了不生效(被 extra="ignore" 静默丢弃)
# TOOLS_ENABLED=

# ===== 记忆 (v0.4) =====
# v0.4新增: 长期记忆向量检索(可选)
# 注意: DeepSeek不提供embedding API。不配置则自动降级FTS5关键词检索(零配置可用)
# 示例(硅基流动): EMBEDDING_MODEL=BAAI/bge-m3
#                 EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#                 EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# v0.5新增: API服务（uv run python -m agent_pro.api）
API_HOST=0.0.0.0        # 局域网测试; 仅本机用127.0.0.1
API_PORT=8000
API_AUTH_KEY=请改成足够长的随机字符串   # 空值=服务拒绝启动

# v0.6: 知识库文档目录(默认./knowledge, 可用绝对路径覆盖)
# KB_DIR=./knowledge

# 注: 短期记忆轮数用 MEMORY_SHORT_TERM_ROUNDS / MEMORY_COMPACT_BATCH;
# MEMORY_WINDOW_SIZE 无对应字段, 写了不生效
# MEMORY_WINDOW_SIZE=10

# ===== RAG (v0.5) =====
# 注: 不要在此处重复定义 EMBEDDING_MODEL —— dotenv 对同名键**后者生效**, 再写一次会
# 覆盖上面 v0.4 区块的空值, 把 embedding 意外启用(拿 LLM 的 key 打 api.openai.com,
# 401), 反而不按 v0.4 说明降级纯 FTS5。embedding 只在上面 v0.4 区块配置一次。
# VECTOR_STORE_PATH 无对应字段(向量随知识库落在 DATA_DIR)。
# EMBEDDING_MODEL=
# VECTOR_STORE_PATH=

# ===== 评估 (v0.6) =====
# 必须是数据集**文件**路径而非目录 —— eval/runner.py 直接 read_text() + json.loads
EVAL_DATASET_PATH=./eval/gold_dataset.json

# ===== 可观测性 (v0.7) =====
LOG_LEVEL=INFO                 # DEBUG/INFO/WARNING/ERROR
LOG_DIR=./logs                 # 结构化日志落盘目录(已 gitignore)

# ===== 可观测性 (v0.8) =====
# 注: 以下键在 config.Settings 里没有对应字段; 且 pydantic-settings 只把 .env 的值
# 交给 Settings, **不会**写入 os.environ —— 而 LangSmith / OTLP 是直接读环境变量的,
# 所以写在 .env 里不生效。要启用请设为**系统环境变量**。
# LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# OTLP_ENDPOINT=

# ===== 状态持久化 (v0.9) =====
# Redis 后端(可选): 留空=默认 redis://localhost:6379; 不可用时自动降级内存态(重启丢)
# REDIS_URL=redis://localhost:6379
